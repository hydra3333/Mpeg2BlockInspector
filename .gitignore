# Visual Studio working state (per-user, often locked while VS is open)
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build output folders (check none of these hold real source in this repo)
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]64/
[Bb]in/
[Oo]bj/
build/
out/

# C++ IntelliSense / browse databases
ipch/
*.ipch
*.VC.db
*.VC.VC.opendb
*.sdf
*.opensdf

# Compiler and linker intermediates
*.obj
*.pch
*.pdb
*.idb
*.ilk
*.iobj
*.ipdb
*.tlog
*.lastbuildstate
*.aps

# extraneous log files
vs/A3_LTCGOUT_SCRATCH/
vs/A3_LTCG_SUPPRESS_SCRATCH/
vs/VapourSynth-mpeg2Deblock/*.log

# CMake per-user presets (keep CMakePresets.json; ignore only the user file)
CMakeUserPresets.json

**/__pycache__/
*.pyc
